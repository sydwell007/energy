# Public site URL - used for metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://energy.civitasholdings.co.za

# Afrihost PHP bridge (public/php). Leave unset locally to use the built-in
# graceful "not connected yet" fallback response on every lead-capture form.
ENERGY_BRIDGE_URL=https://energy.civitasholdings.co.za/php/
ENERGY_API_KEY=
ENERGY_API_TIMEOUT_MS=10000

# The Next.js app calls the protected PHP health check at:
#   ${ENERGY_BRIDGE_URL}/health.php
